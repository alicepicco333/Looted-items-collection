    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="http://www.itemsontology.com/item_features/Paracas_textiles_Gothenburg">
        <rdfs:label>Paracas Textiles</rdfs:label>
        <dc:title>The Paracas textiles of Gothenburg</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q1127723"/>
        <dc:description>Embroidered mantles and textiles from the burial bundles of the Paracas Necropolis on the south coast of Peru. Smuggled to Sweden in the 1930s by the Swedish consul Sven Karell and kept in Gothenburg; returned to Peru in stages between 2014 and 2021.</dc:description>
        <dc:subject>Textile fabrics, Peruvian</dc:subject>
        <dc:subject>Paracas culture</dc:subject>
        <dc:subject>Embroidery</dc:subject>
        <dc:type>Textiles</dc:type>
        <dct:created>c. 200 BCE–200 CE</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q2735703"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Paracas_Textiles_production"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Paracas_Textiles_export_1930s"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Paracas_Textiles_return_2014_2021"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Paracas_Textiles_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q419"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q419"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-13.83</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-76.25</geo:long>
    </cid:E22>

