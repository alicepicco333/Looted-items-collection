        <cid:P4_has_time-span>1820</cid:P4_has_time-span>
        <cid:P3_has_note>Cut out with saws, chisels and gunpowder for the collector Sébastien Louis Saulnier.</cid:P3_has_note>
    </cid:E9>
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Dendera_Zodiac_purchase_1821">
        <rdfs:label>Purchase by Louis XVIII</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Sebastien_Louis_Saulnier"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q90"/>
        <cid:P4_has_time-span>1821</cid:P4_has_time-span>
        <cid:P3_has_note>Shown in the royal library, in the Louvre since 1922.</cid:P3_has_note>
    </cid:E8>
