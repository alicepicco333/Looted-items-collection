    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q494235">
        <rdfs:label>Diamond Sutra</rdfs:label>
        <dc:title>The Diamond Sutra (Dunhuang, 868)</dc:title>
        <dc:creator>Printed for Wang Jie</dc:creator>
        <dc:description>Printed scroll of the Diamond Sutra, dated 868, the world&#x27;s earliest dated printed book. Found in the sealed Library Cave at Mogao and sold by the Daoist monk Wang Yuanlu to Aurel Stein in 1907; in the British Library.</dc:description>
        <dc:subject>Buddhist literature</dc:subject>
        <dc:subject>Printing--History</dc:subject>
        <dc:subject>Dunhuang manuscripts</dc:subject>
        <dc:type>Printed scroll</dc:type>
        <dct:created>868 CE</dct:created>
        <dct:spatial>Mogao Caves, Dunhuang (China)</dct:spatial>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Diamond_Sutra_production"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Diamond_Sutra_sealing"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Diamond_Sutra_sale_1907"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Diamond_Sutra_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q23308"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q23308"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">40.0425</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">94.8042</geo:long>
    </cid:E22>

    <!-- making -->
