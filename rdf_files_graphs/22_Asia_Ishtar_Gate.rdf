    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q26082">
        <rdfs:label>Ishtar Gate</rdfs:label>
        <dc:title>The Ishtar Gate of Babylon</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q12591"/>
        <dc:description>Monumental gate of glazed bricks with dragons and bulls, built for Nebuchadnezzar II on the processional way of Babylon. Excavated by Robert Koldewey from 1902, shipped to Berlin and reconstructed in the Pergamon Museum from 1928. Iraqi officials have called for its return.</dc:description>
        <dc:subject>Babylon (Extinct city)</dc:subject>
        <dc:subject>Glazed brick</dc:subject>
        <dc:subject>Architecture, Babylonian</dc:subject>
        <dc:type>Gate (glazed brick)</dc:type>
        <dct:created>c. 575 BCE</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q5684"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Ishtar_Gate_production"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Ishtar_Gate_excavation"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Ishtar_Gate_division_1926"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Ishtar_Gate_reconstruction"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Ishtar_Gate_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q157298"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q685171"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">32.5364</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">44.421</geo:long>
    </cid:E22>

    <!-- making -->
    <cid:E12 rdf:about="http://www.itemsontology.com/item_features/Ishtar_Gate_production">
