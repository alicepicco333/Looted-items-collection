    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q3100139">
        <rdfs:label>Dendera Zodiac</rdfs:label>
        <dc:title>The Dendera Zodiac</dc:title>
        <dc:creator>Unknown (Ptolemaic Egypt)</dc:creator>
        <dc:description>Sandstone ceiling relief from a chapel on the roof of the Temple of Hathor at Dendera, a map of the sky with the zodiac and constellations. Cut out with explosives in 1820 and taken to Paris; in the Louvre since 1922. Egypt has asked for its return.</dc:description>
        <dc:subject>Astronomy, Egyptian</dc:subject>
        <dc:subject>Zodiac</dc:subject>
        <dc:subject>Temple of Hathor (Dendera)</dc:subject>
        <dc:type>Ceiling relief</dc:type>
        <dct:created>c. 50 BCE</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q735254"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Dendera_Zodiac_production"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Dendera_Zodiac_removal_1820"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Dendera_Zodiac_purchase_1821"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Dendera_Zodiac_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q19675"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q19675"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">26.1417</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">32.67</geo:long>
    </cid:E22>

