    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q304483">
        <rdfs:label>Priam&#x27;s Treasure</rdfs:label>
        <dc:title>The Treasure of Priam (Troy)</dc:title>
        <dc:creator>Unknown (Troy II)</dc:creator>
        <dc:description>Hoard of gold, silver and bronze objects found by Heinrich Schliemann at Troy in 1873 and smuggled out of the Ottoman Empire. Given to Berlin in 1881, taken by the Red Army in 1945 and revealed in the 1990s to be in Moscow&#x27;s Pushkin Museum; claimed by Germany and by Türkiye.</dc:description>
        <dc:subject>Troy (Extinct city)--Antiquities</dc:subject>
        <dc:subject>Goldwork, Prehistoric</dc:subject>
        <dc:subject>Spoils of war</dc:subject>
        <dc:type>Hoard of gold and metal objects</dc:type>
        <dct:created>c. 2500–2300 BCE</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q22647"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Priams_Treasure_production"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Priams_Treasure_smuggling_1873"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Priams_Treasure_seizure_1945"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Priams_Treasure_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q4872"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q4872"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">39.9575</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">26.2389</geo:long>
    </cid:E22>

