        <cid:P4_has_time-span>1873</cid:P4_has_time-span>
        <cid:P3_has_note>Settled with the Ottoman government in 1875; donated to Berlin in 1881.</cid:P3_has_note>
    </cid:E9>
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Priams_Treasure_seizure_1945">
        <rdfs:label>Seizure by the Red Army</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Red_Army_trophy_brigades"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q649"/>
        <cid:P3_has_note>From Berlin</cid:P3_has_note>
        <cid:P4_has_time-span>1945</cid:P4_has_time-span>
        <cid:P3_has_note>Kept secret until the 1990s; on display since 1996.</cid:P3_has_note>
    </cid:E8>
