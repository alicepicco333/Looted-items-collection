    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q734834">
        <rdfs:label>Ghent Altarpiece</rdfs:label>
        <dc:title>The Ghent Altarpiece (Adoration of the Mystic Lamb)</dc:title>
        <dc:creator rdf:resource="http://www.itemsontology.com/item_features/Hubert_and_Jan_van_Eyck"/>
        <dc:description>Polyptych by Hubert and Jan van Eyck completed in 1432 for St Bavo&#x27;s in Ghent, often called the most stolen artwork in history. Panels were taken to Paris by French revolutionary troops in 1794, sold and taken to Berlin, stolen in 1934, and seized by the Nazis before its recovery from the Altaussee salt mine in 1945.</dc:description>
        <dc:subject>Painting, Flemish</dc:subject>
        <dc:subject>Altarpieces</dc:subject>
        <dc:subject>Art thefts</dc:subject>
        <dc:type>Polyptych</dc:type>
        <dct:created>1432</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q1296"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_seizure_1794"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_sale_1816"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_theft_1934"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_seizure_1942"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_recovery_1945"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Ghent_Altarpiece_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q938154"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q938154"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">51.053</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">3.7275</geo:long>
    </cid:E22>

    <!-- making -->
    <cid:E12 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_production">
