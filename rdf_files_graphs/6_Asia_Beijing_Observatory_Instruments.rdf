        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q320404"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q1711"/>
        <cid:P3_has_note>From Beijing Ancient Observatory</cid:P3_has_note>
        <cid:P4_has_time-span>1900-1901</cid:P4_has_time-span>
        <cid:P3_has_note>After the Boxer War; the French share went to the French legation, the German share to the gardens of the Potsdam palaces.</cid:P3_has_note>
