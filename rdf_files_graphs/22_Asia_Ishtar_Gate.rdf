    <!-- history -->
    <cid:E7 rdf:about="http://www.itemsontology.com/item_features/Ishtar_Gate_excavation">
        <rdfs:label>Excavation at Babylon</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q60700"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q5684"/>
        <cid:P4_has_time-span>1899-1917</cid:P4_has_time-span>
        <cid:P3_has_note>Excavated for the Deutsche Orient-Gesellschaft; the gate was uncovered from 1902.</cid:P3_has_note>
    </cid:E7>
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Ishtar_Gate_division_1926">
        <rdfs:label>Division of finds and shipment to Berlin</rdfs:label>
        <cid:P27_moved_from rdf:resource="https://www.wikidata.org/wiki/Q5684"/>
        <cid:P26_moved_to rdf:resource="https://www.wikidata.org/wiki/Q64"/>
        <cid:P4_has_time-span>1926-1927</cid:P4_has_time-span>
        <cid:P3_has_note>Agreed with the Iraqi Department of Antiquities under the British mandate.</cid:P3_has_note>
    </cid:E9>
    <cid:E7 rdf:about="http://www.itemsontology.com/item_features/Ishtar_Gate_reconstruction">
