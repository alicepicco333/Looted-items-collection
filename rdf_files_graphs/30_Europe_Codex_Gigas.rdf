    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q212180">
        <rdfs:label>Codex Gigas</rdfs:label>
        <dc:title>Codex Gigas (the Devil&#x27;s Bible)</dc:title>
        <dc:creator rdf:resource="http://www.itemsontology.com/item_features/Podlazice_monastery"/>
        <dc:description>The largest surviving medieval manuscript, made in the Benedictine monastery of Podlažice in Bohemia and famous for its full-page picture of the Devil. Taken from Prague Castle by the Swedish army in 1648; in the National Library of Sweden since 1878, lent to Prague in 2007–2008.</dc:description>
        <dc:subject>Manuscripts, Latin (Medieval and modern)</dc:subject>
        <dc:subject>Bible</dc:subject>
        <dc:subject>Thirty Years&#x27; War, 1618-1648--Spoils</dc:subject>
        <dc:type>Manuscript</dc:type>
        <dct:created>early 13th century</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q1076872"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Codex_Gigas_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Codex_Gigas_acquisition_1594"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Codex_Gigas_seizure_1648"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Codex_Gigas_loan_2007"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Codex_Gigas_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q953058"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q953058"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">50.0755</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">14.4378</geo:long>
    </cid:E22>

