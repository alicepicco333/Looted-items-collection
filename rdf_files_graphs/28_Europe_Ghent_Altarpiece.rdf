    <!-- history -->
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_seizure_1794">
        <rdfs:label>Seizure of the central panels</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/French_revolutionary_commissioners"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q90"/>
        <cid:P3_has_note>From Ghent</cid:P3_has_note>
        <cid:P4_has_time-span>1794</cid:P4_has_time-span>
        <cid:P3_has_note>Returned in 1815.</cid:P3_has_note>
    </cid:E8>
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_sale_1816">
        <rdfs:label>Sale of the wings</rdfs:label>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q64"/>
        <cid:P3_has_note>From Ghent</cid:P3_has_note>
        <cid:P4_has_time-span>1816</cid:P4_has_time-span>
        <cid:P3_has_note>Bought by Frederick William III of Prussia in 1821; returned under Article 247 of the Treaty of Versailles.</cid:P3_has_note>
    </cid:E8>
    <cid:E7 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_theft_1934">
        <rdfs:label>Theft of two panels</rdfs:label>
        <cid:P4_has_time-span>1934</cid:P4_has_time-span>
        <cid:P3_has_note>The Just Judges panel has never been recovered.</cid:P3_has_note>
    </cid:E7>
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_seizure_1942">
        <rdfs:label>Seizure by Nazi Germany</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Nazi_German_authorities"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q262951"/>
        <cid:P3_has_note>From Ghent</cid:P3_has_note>
        <cid:P4_has_time-span>1942</cid:P4_has_time-span>
        <cid:P3_has_note>Taken from Pau to Germany and stored in the Altaussee salt mine.</cid:P3_has_note>
    </cid:E8>
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_recovery_1945">
        <rdfs:label>Recovery and return</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q2273396"/>
        <cid:P27_moved_from rdf:resource="https://www.wikidata.org/wiki/Q262951"/>
        <cid:P26_moved_to rdf:resource="https://www.wikidata.org/wiki/Q1296"/>
        <cid:P4_has_time-span>1945</cid:P4_has_time-span>
    </cid:E9>
    <cid:E3 rdf:about="http://www.itemsontology.com/item_features/Ghent_Altarpiece_condition">
        <rdfs:label>Returned</rdfs:label>
        <cid:P3_has_note>Returned. The Just Judges panel is a copy.</cid:P3_has_note>
    </cid:E3>

