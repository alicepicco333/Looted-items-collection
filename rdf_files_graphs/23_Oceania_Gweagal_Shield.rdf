    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q106238830">
        <rdfs:label>Gweagal Shield</rdfs:label>
        <dc:title>Bark shield (the Gweagal shield)</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q7710757"/>
        <dc:description>Bark shield in the British Museum long identified as the shield taken at Kamay (Botany Bay) in April 1770, when James Cook&#x27;s crew landed and shot at Gweagal men. The identification is debated; the Gweagal descendant Rodney Kelly has asked for its return.</dc:description>
        <dc:subject>Aboriginal Australians--Weapons</dc:subject>
        <dc:subject>Cook, James, 1728-1779</dc:subject>
        <dc:subject>Botany Bay (N.S.W.)</dc:subject>
        <dc:type>Shield</dc:type>
        <dct:created>before 1770</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q894682"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Gweagal_Shield_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Gweagal_Shield_taking_1770"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Gweagal_Shield_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q6373"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q6373"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-34.0045</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">151.221</geo:long>
    </cid:E22>

