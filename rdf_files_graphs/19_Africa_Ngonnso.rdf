        <cid:P3_has_note>Donated to the Royal Museum of Ethnology, Berlin, in 1903.</cid:P3_has_note>
    </cid:E8>
    <cid:E7 rdf:about="http://www.itemsontology.com/item_features/Ngonnso_decision_2022">
        <rdfs:label>Decision to return</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q685171"/>
        <cid:P4_has_time-span>2022</cid:P4_has_time-span>
        <cid:P3_has_note>Return authorised in June 2022; delayed by the conflict in Cameroon&#x27;s Anglophone regions.</cid:P3_has_note>
    </cid:E7>
