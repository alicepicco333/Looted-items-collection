    <!-- the object -->
    <cid:E22 rdf:about="http://www.itemsontology.com/item_features/Kalaniopuu_ahu_ula_and_mahiole">
        <rdfs:label>Kalaniʻōpuʻu&#x27;s Cloak and Helmet</rdfs:label>
        <dc:title>ʻAhu ʻula and mahiole of Kalaniʻōpuʻu</dc:title>
        <dc:creator>Hawaiian featherworkers</dc:creator>
        <dc:description>Feathered cloak (ʻahu ʻula) and helmet (mahiole) that the high chief Kalaniʻōpuʻu gave to James Cook at Kealakekua Bay in 1779. Given to New Zealand&#x27;s Dominion Museum in 1912, they returned to Hawaiʻi on loan in 2016 and permanently in 2020, held by Bishop Museum.</dc:description>
        <dc:subject>Featherwork--Hawaii</dc:subject>
        <dc:subject>Kalaniʻōpuʻu, -1782</dc:subject>
        <dc:subject>Cook, James, 1728-1779</dc:subject>
        <dc:type>Feather cloak and helmet</dc:type>
        <dct:created>before 1779</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q2879655"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Kalaniopuu_Cloak_and_Helmet_production"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Kalaniopuu_Cloak_and_Helmet_gift_1779"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Kalaniopuu_Cloak_and_Helmet_gift_1912"/>
