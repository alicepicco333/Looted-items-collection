    <!-- history -->
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Paracas_Textiles_export_1930s">
        <rdfs:label>Illegal export to Sweden</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Sven_Karell"/>
        <cid:P27_moved_from rdf:resource="https://www.wikidata.org/wiki/Q419"/>
        <cid:P26_moved_to rdf:resource="https://www.wikidata.org/wiki/Q25287"/>
        <cid:P4_has_time-span>1930s</cid:P4_has_time-span>
        <cid:P3_has_note>Exported by the Swedish consul in Lima contrary to Peruvian heritage law.</cid:P3_has_note>
    </cid:E9>
    <cid:E10 rdf:about="http://www.itemsontology.com/item_features/Paracas_Textiles_return_2014_2021">
        <rdfs:label>Return to Peru</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q378377"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q419"/>
        <cid:P3_has_note>From Gothenburg</cid:P3_has_note>
        <cid:P4_has_time-span>2014-2021</cid:P4_has_time-span>
        <cid:P3_has_note>89 textiles returned in several shipments after a Swedish government decision of 2013.</cid:P3_has_note>
    </cid:E10>
