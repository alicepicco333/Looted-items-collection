    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q439299">
        <rdfs:label>Beijing Observatory Instruments</rdfs:label>
        <dc:title>Astronomical instruments of the Beijing Ancient Observatory</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q378277"/>
        <dc:description>Bronze astronomical instruments of the imperial observatory of Beijing, including armillary spheres, a celestial globe and a quadrant. Taken by French and German troops after the Boxer Rebellion in 1900, they were returned by France in 1902 and by Germany in 1921 under Article 131 of the Treaty of Versailles.</dc:description>
        <dc:subject>Astronomical instruments</dc:subject>
        <dc:subject>Beijing (China)--History</dc:subject>
        <dc:subject>Boxer Rebellion, 1899-1901</dc:subject>
        <dc:type>Scientific instruments</dc:type>
        <dct:created>1439–1744</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q439299"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Beijing_Observatory_Instruments_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Beijing_Observatory_Instruments_seizure_1900"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Beijing_Observatory_Instruments_return_1902"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Beijing_Observatory_Instruments_return_1921"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Beijing_Observatory_Instruments_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q439299"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q439299"/>
