        <rdfs:label>Making of the Diamond Sutra</rdfs:label>
        <cid:P4_has_time-span>868 CE</cid:P4_has_time-span>
    </cid:E12>

    <!-- history -->
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Diamond_Sutra_sealing">
        <rdfs:label>Deposit in the Library Cave</rdfs:label>
        <cid:P26_moved_to rdf:resource="https://www.wikidata.org/wiki/Q43286"/>
        <cid:P4_has_time-span>c. 1000</cid:P4_has_time-span>
        <cid:P3_has_note>The cave was sealed in the early 11th century.</cid:P3_has_note>
    </cid:E9>
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Diamond_Sutra_sale_1907">
        <rdfs:label>Sale to Aurel Stein</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q313061"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q84"/>
        <cid:P3_has_note>From Mogao Caves</cid:P3_has_note>
        <cid:P4_has_time-span>1907</cid:P4_has_time-span>
        <cid:P3_has_note>Obtained from Wang Yuanlu in exchange for donations to his restoration of the caves.</cid:P3_has_note>
    </cid:E8>
    <cid:E3 rdf:about="http://www.itemsontology.com/item_features/Diamond_Sutra_condition">
        <rdfs:label>No formal claim</rdfs:label>
