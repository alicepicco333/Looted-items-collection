    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q7272045">
        <rdfs:label>Quimbaya Treasure</rdfs:label>
        <dc:title>The Quimbaya Treasure</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q958351"/>
        <dc:description>122 gold objects from two tombs found at Filandia in 1890, given by Colombia&#x27;s president Carlos Holguín to Queen Maria Cristina of Spain in 1893. In the Museo de América in Madrid. In 2017 Colombia&#x27;s Constitutional Court ordered the government to seek their return.</dc:description>
        <dc:subject>Goldwork, Pre-Columbian--Colombia</dc:subject>
        <dc:subject>Quimbaya Indians</dc:subject>
        <dc:subject>Funerary objects</dc:subject>
        <dc:type>Gold objects</dc:type>
        <dct:created>c. 250–430 CE</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q1525384"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Quimbaya_Treasure_production"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Quimbaya_Treasure_find_1890"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Quimbaya_Treasure_gift_1893"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Quimbaya_Treasure_ruling_2017"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Quimbaya_Treasure_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q2568412"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q2568412"/>
