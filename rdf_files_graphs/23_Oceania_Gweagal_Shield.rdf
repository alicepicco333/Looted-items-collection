    <!-- history -->
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Gweagal_Shield_taking_1770">
        <rdfs:label>Taking at Kamay</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q7324"/>
        <cid:P7_took_place_at rdf:resource="https://www.wikidata.org/wiki/Q84"/>
        <cid:P3_has_note>From Kamay (Botany Bay)</cid:P3_has_note>
        <cid:P4_has_time-span>1770-04-29</cid:P4_has_time-span>
        <cid:P3_has_note>Taken with about forty spears when Cook&#x27;s crew landed and shot at Gweagal men; the British Museum shield&#x27;s identification is debated.</cid:P3_has_note>
    </cid:E8>
    <cid:E3 rdf:about="http://www.itemsontology.com/item_features/Gweagal_Shield_condition">
        <rdfs:label>Contested</rdfs:label>
        <cid:P3_has_note>Contested. Claimed by Rodney Kelly.</cid:P3_has_note>
    </cid:E3>

