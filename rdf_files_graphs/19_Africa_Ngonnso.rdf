    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q119723801">
        <rdfs:label>Ngonnso&#x27;</rdfs:label>
        <dc:title>Ngonnso&#x27;</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q7067573"/>
        <dc:description>Carved figure representing Ngonnso&#x27;, founder and mother of the Nso&#x27; people of Cameroon. Taken by the colonial officer Kurt von Pavel and given to Berlin&#x27;s Ethnological Museum in 1903. The Prussian Cultural Heritage Foundation agreed to return her in 2022.</dc:description>
        <dc:subject>Nso (African people)</dc:subject>
        <dc:subject>Sculpture, Cameroonian</dc:subject>
        <dc:subject>Mother goddesses</dc:subject>
        <dc:type>Figure</dc:type>
        <dct:created>19th century</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q2533580"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Ngonnso_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Ngonnso_seizure_1902"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Ngonnso_decision_2022"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Ngonnso_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q688353"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q685171"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">6.2167</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">10.6833</geo:long>
    </cid:E22>

