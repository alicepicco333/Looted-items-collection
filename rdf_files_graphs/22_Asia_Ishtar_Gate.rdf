        <cid:P4_has_time-span>1928-1930</cid:P4_has_time-span>
    </cid:E7>
    <cid:E3 rdf:about="http://www.itemsontology.com/item_features/Ishtar_Gate_condition">
        <rdfs:label>Return called for by Iraqi officials</rdfs:label>
        <cid:P3_has_note>Return called for by Iraqi officials.</cid:P3_has_note>
