    <!-- history -->
    <cid:E8 rdf:about="http://www.itemsontology.com/item_features/Ngonnso_seizure_1902">
        <rdfs:label>Seizure during the German campaign against Nso&#x27;</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Kurt_von_Pavel"/>
