    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Priams_Treasure_smuggling_1873">
        <rdfs:label>Excavation and smuggling out of the Ottoman Empire</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="https://www.wikidata.org/wiki/Q57106"/>
