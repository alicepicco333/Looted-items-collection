    <!-- history -->
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Penacho_de_Moctezuma_europe">
        <rdfs:label>Transfer to Europe after the Spanish conquest</rdfs:label>
        <cid:P27_moved_from rdf:resource="https://www.wikidata.org/wiki/Q13695"/>
