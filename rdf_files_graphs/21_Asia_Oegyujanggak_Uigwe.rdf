    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q1073141">
        <rdfs:label>Oegyujanggak Uigwe</rdfs:label>
        <dc:title>Oegyujanggak Uigwe (Royal protocols of the Joseon dynasty)</dc:title>
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q28179"/>
        <dc:description>Illustrated records of the state rites of the Joseon court, kept in the royal library annex on Ganghwa Island. French troops took 297 volumes in 1866; found in the Bibliothèque nationale de France in 1975, they returned to Korea in 2011 on a renewable loan.</dc:description>
        <dc:subject>Joseon dynasty, 1392-1910</dc:subject>
        <dc:subject>Rites and ceremonies--Korea</dc:subject>
        <dc:subject>Illustrated manuscripts</dc:subject>
        <dc:type>Illustrated manuscripts</dc:type>
        <dct:created>17th–19th century</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q494786"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Oegyujanggak_Uigwe_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Oegyujanggak_Uigwe_seizure_1866"/>
        <cid:P12i_was_present_at rdf:resource="http://www.itemsontology.com/item_features/Oegyujanggak_Uigwe_identification_1975"/>
        <cid:P30i_custody_transferred_through rdf:resource="http://www.itemsontology.com/item_features/Oegyujanggak_Uigwe_return_2011"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Oegyujanggak_Uigwe_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q494407"/>
