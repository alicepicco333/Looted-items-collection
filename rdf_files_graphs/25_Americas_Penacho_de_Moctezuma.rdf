    <!-- Written September 2026. Wikidata identifiers were checked against the Wikipedia
         articles' linked Wikidata items; entities without one use itemsontology URIs. -->

    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q948240">
        <rdfs:label>Moctezuma&#x27;s Headdress</rdfs:label>
        <dc:title>Penacho (the feather headdress known as Moctezuma&#x27;s)</dc:title>
        <dc:creator rdf:resource="http://www.itemsontology.com/item_features/Amanteca_featherworkers"/>
        <dc:description>Headdress of quetzal and other feathers with gold, one of the very few surviving pieces of Aztec featherwork. Recorded in European collections from the 16th century, it is in the Weltmuseum Wien. Mexico has asked for it; a 2010–2012 binational study judged it too fragile to travel.</dc:description>
        <dc:subject>Featherwork--Mexico</dc:subject>
        <dc:subject>Aztecs--Antiquities</dc:subject>
        <dc:subject>Moctezuma II</dc:subject>
        <dc:type>Feather headdress</dc:type>
        <dct:created>c. 1515</dct:created>
        <dct:spatial rdf:resource="https://www.wikidata.org/wiki/Q13695"/>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Penacho_de_Moctezuma_production"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Penacho_de_Moctezuma_europe"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Penacho_de_Moctezuma_vienna"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Penacho_de_Moctezuma_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q686488"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q686488"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">19.4326</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-99.1332</geo:long>
    </cid:E22>

