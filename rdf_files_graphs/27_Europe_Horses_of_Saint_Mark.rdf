    <!-- the object -->
    <cid:E22 rdf:about="https://www.wikidata.org/wiki/Q1994701">
        <rdfs:label>Horses of Saint Mark</rdfs:label>
        <dc:title>The Horses of Saint Mark (Triumphal Quadriga)</dc:title>
        <dc:creator>Unknown (Roman or Greek)</dc:creator>
        <dc:description>Four gilded bronze horses taken from Constantinople by the Venetians in the Fourth Crusade (1204) and set on the façade of St Mark&#x27;s Basilica. Taken to Paris by Napoleon in 1797, returned to Venice in 1815; the originals are now inside the basilica, replaced outside by copies.</dc:description>
        <dc:subject>Bronze sculpture, Classical</dc:subject>
        <dc:subject>Venice (Italy)--History</dc:subject>
        <dc:subject>Spoils of war</dc:subject>
        <dc:type>Bronze sculpture</dc:type>
        <dct:created>2nd–3rd century CE (disputed)</dct:created>
        <dct:spatial>Hippodrome of Constantinople</dct:spatial>
        <cid:P108i_was_produced_by rdf:resource="http://www.itemsontology.com/item_features/Horses_of_Saint_Mark_production"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Horses_of_Saint_Mark_sack_1204"/>
        <cid:P24i_changed_ownership_through rdf:resource="http://www.itemsontology.com/item_features/Horses_of_Saint_Mark_seizure_1797"/>
        <cid:P25i_moved_by rdf:resource="http://www.itemsontology.com/item_features/Horses_of_Saint_Mark_return_1815"/>
        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Horses_of_Saint_Mark_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q172988"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q172988"/>
        <geo:lat rdf:datatype="http://www.w3.org/2001/XMLSchema#float">41.0082</geo:lat>
        <geo:long rdf:datatype="http://www.w3.org/2001/XMLSchema#float">28.9784</geo:long>
    </cid:E22>

