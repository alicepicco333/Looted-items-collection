        <cid:P44_has_condition rdf:resource="http://www.itemsontology.com/item_features/Kalaniopuu_Cloak_and_Helmet_condition"/>
        <cid:P55_has_current_location rdf:resource="https://www.wikidata.org/wiki/Q826520"/>
        <cid:P52_has_current_owner rdf:resource="https://www.wikidata.org/wiki/Q826520"/>
