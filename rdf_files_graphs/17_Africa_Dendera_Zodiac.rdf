    <!-- history -->
    <cid:E9 rdf:about="http://www.itemsontology.com/item_features/Dendera_Zodiac_removal_1820">
        <rdfs:label>Removal from the temple</rdfs:label>
        <cid:P14_carried_out_by rdf:resource="http://www.itemsontology.com/item_features/Jean-Baptiste_Lelorrain"/>
        <cid:P27_moved_from rdf:resource="https://www.wikidata.org/wiki/Q735254"/>
